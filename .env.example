# Copy to .env.local and fill in. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API (Data API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-only secret key (sb_secret_...) or legacy service_role JWT.
# Used for payments, QR credentials, PIN emails and webhooks.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional, server-only: direct Postgres URL (only for CLI tooling such as type generation).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Public base URL of the app (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Set to true only after enabling Google in Supabase -> Authentication -> Providers.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Optional sender, e.g. "Clunite <noreply@yourdomain.com>" (defaults to Resend's onboarding sender)
EMAIL_FROM=

# --- Payments -------------------------------------------------------------------
# mock = no network, simulated success/failure (default). razorpay = Razorpay TEST mode.
PAYMENTS_MODE=mock
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- QR ID cards ------------------------------------------------------------------
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
QR_SIGNING_SECRET=change-me-to-a-long-random-string

# --- Cron (optional) ---------------------------------------------------------------
# Shared secret for GET /api/cron/expire-memberships (send as Authorization: Bearer <secret>)
CRON_SECRET=
